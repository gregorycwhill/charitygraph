{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CauseBase: tests",
      "type": "shell",
      "command": "uv run pytest",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "CauseBase: demo build",
      "type": "shell",
      "command": "uv run causebase demo-build --output ../../work/staging/publication/demo",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CauseBase: validate staged demo",
      "type": "shell",
      "command": "uv run causebase validate --output ../../work/staging/publication/demo",
      "problemMatcher": []
    }
  ]
}
