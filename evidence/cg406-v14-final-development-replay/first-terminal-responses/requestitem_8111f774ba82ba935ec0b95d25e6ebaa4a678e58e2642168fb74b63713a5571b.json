          "text": "{\"conclusion\":{\"confidence\":\"high\",\"evidence\":[{\"additional_meanings\":[],\"evidence_id\":\"srcrec:ced5cc8a79973a0953c6c41bd8f88acf0d764c99a12c9bf4d2c2b961eb1348aa\",\"note\":\"The official homepage lists participation/support routes including volunteering, fundraising, workplace giving, and donations, and describes the organisation's conservation work.\",\"role\":\"supporting\"},{\"additional_meanings\":[],\"evidence_id\":\"srcrec:ac73e24cb901ae625aaa48c4e92bcd37cb112acaa3ba19b807feb039ad76a0e2\",\"note\":\"The regulator material identifies Australian conservation programs and their Australian program locations, but does not establish an advertised participation opportunity or its effective period.\",\"role\":\"context\"}],\"outcome\":\"insufficient_evidence\",\"rationale\":\"The supplied evidence identifies participation routes and related conservation programs, but does not establish the requested opportunity-to-service filtered relation or an advertised effective period. It also does not establish eligibility criteria.\"},\"demand_requirement_support\":[{\"evidence_ids\":[\"srcrec:ced5cc8a79973a0953c6c41bd8f88acf0d764c99a12c9bf4d2c2b961eb1348aa\"],\"qualification\":\"The official homepage lists participation/support routes, including volunteering, but the precise advertised opportunity referent is not fully specified.\",\"requirement_id\":\"requirement:191a1c546da0485ed9e5d898af1b1ffeb418aabd4eb46ae8bf689d3d18e06a15\",\"support_state\":\"guarded\"},{\"evidence_ids\":[\"srcrec:ced5cc8a79973a0953c6c41bd8f88acf0d764c99a12c9bf4d2c2b961eb1348aa\",\"srcrec:ac73e24cb901ae625aaa48c4e92bcd37cb112acaa3ba19b807feb039ad76a0e2\"],\"qualification\":\"Participation routes and conservation programs are separately evidenced, but the opportunity-to-service join is not explicitly stated.\",\"requirement_id\":\"requirement:cf04bb838f0c9b844423fe3e93026b8b603ef69d3c6e632226bf39e0fb34c78f\",\"support_state\":\"unresolved\"},{\"evidence_ids\":[\"srcrec:ced5cc8a79973a0953c6c41bd8f88acf0d764c99a12c9bf4d2c2b961eb1348aa\",\"srcrec:ac73e24cb901ae625aaa48c4e92bcd37cb112acaa3ba19b807feb039ad76a0e2\"],\"qualification\":\"The evidence supplies routes and program descriptions but no explicit filtering rule or demonstrated filtered result.\",\"requirement_id\":\"requirement:2781d3045ae1cf50eb1bcb97712e1bd0ce0f553adb635d583f997d7b49b39a46\",\"support_state\":\"unresolved\"},{\"evidence_ids\":[\"srcrec:ced5cc8a79973a0953c6c41bd8f88acf0d764c99a12c9bf4d2c2b961eb1348aa\"],\"qualification\":\"The homepage lists participation routes, but this assessment does not infer enduring participation from that advertisement.\",\"requirement_id\":\"requirement:4316c8f907ac4732f1174b92f7e17035bdf9a2785d766c21e40dfba0ea517a4f\",\"support_state\":\"guarded\"},{\"evidence_ids\":[\"srcrec:ced5cc8a79973a0953c6c41bd8f88acf0d764c99a12c9bf4d2c2b961eb1348aa\"],\"qualification\":\"The official homepage provides direct opportunity-related text through its listed support and participation routes.\",\"requirement_id\":\"requirement:bd739bfa87a3a3b34349f15e515b6b3894389120dd6f68d9c8e658f77605d8d3\",\"support_state\":\"supported\"},{\"evidence_ids\":[\"srcrec:ced5cc8a79973a0953c6c41bd8f88acf0d764c99a12c9bf4d2c2b961eb1348aa\"],\"qualification\":\"The listed routes, including volunteering and fundraising, are relevant to inspecting participation routes.\",\"requirement_id\":\"requirement:7d930f775194cffea0e229640e27a7fdd8d987808c70b60074e21eb81ea49145\",\"support_state\":\"supported\"},{\"evidence_ids\":[\"srcrec:ced5cc8a79973a0953c6c41bd8f88acf0d764c99a12c9bf4d2c2b961eb1348aa\"],\"qualification\":\"The homepage is captured with current-page content but supplies no explicit effective start or end period for the listed opportunities.\",\"requirement_id\":\"requirement:95de788b4433cf6ac38459d0bddd11b56671d790f2a313a839c7ca57ef7c9370\",\"support_state\":\"not_established\"}],\"proposition_support\":[{\"evidence_ids\":[],\"proposition_id\":\"proposition:533cbfe95669c4