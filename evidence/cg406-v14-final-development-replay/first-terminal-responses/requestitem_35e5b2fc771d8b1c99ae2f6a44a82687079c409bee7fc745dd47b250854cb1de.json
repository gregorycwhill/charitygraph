          "text": "{\"conclusion\":{\"confidence\":\"medium\",\"evidence\":[{\"additional_meanings\":[],\"evidence_id\":\"srcrec:d8fb209670cfca62611a7804c58e10d05c8f2e1e39d5d5b369c61620a39c5f32\",\"note\":\"The annual report identifies governance officials, positions, appointment dates, and a resignation date on pages 22\u201323.\",\"role\":\"supporting\"},{\"additional_meanings\":[],\"evidence_id\":\"srcrec:a55c4f584d0df7b56e6bbb0836535a932715ccc7d22cf1b92efadab56aa87298\",\"note\":\"The ACNC register identifies the organisation and lists responsible persons, but does not provide a complete tenure interval for the target subject.\",\"role\":\"supporting\"}],\"outcome\":\"insufficient_evidence\",\"rationale\":\"The supplied evidence establishes dated governance records for Caritas Australia Limited, but it does not bind the opaque target subject to a particular named governance official or establish all requested role-to-organisation, role-to-period, comparison, lookup, and tenure obligations.\"},\"demand_requirement_support\":[{\"evidence_ids\":[\"srcrec:a55c4f584d0df7b56e6bbb0836535a932715ccc7d22cf1b92efadab56aa87298\",\"srcrec:d8fb209670cfca62611a7804c58e10d05c8f2e1e39d5d5b369c61620a39c5f32\"],\"qualification\":\"Governance roles and appointment dates are documented for named responsible persons, but the target subject is not bound to one of those persons.\",\"requirement_id\":\"requirement:9727740f789caee970f9c53588a6a76488d9c1424309b6cfc9ce9d3f9ce39a11\",\"support_state\":\"guarded\"},{\"evidence_ids\":[\"srcrec:a55c4f584d0df7b56e6bbb0836535a932715ccc7d22cf1b92efadab56aa87298\",\"srcrec:d8fb209670cfca62611a7804c58e10d05c8f2e1e39d5d5b369c61620a39c5f32\"],\"qualification\":\"The named governance officials are associated with Caritas Australia Limited, but target-subject identity binding to an official is not established.\",\"requirement_id\":\"requirement:8caf15a6d8b0b9fbf9165d1d9c3cef125bed0e782c5f663c03d297381732db10\",\"support_state\":\"guarded\"},{\"evidence_ids\":[\"srcrec:d8fb209670cfca62611a7804c58e10d05c8f2e1e39d5d5b369c61620a39c5f32\"],\"qualification\":\"Appointment dates and one resignation date are supplied for named officials, but no complete target-subject role-to-period binding is supplied.\",\"requirement_id\":\"requirement:f7f8adab5161ca66425a8b2d489d2837e3d92dd3f4ef845f913173af993dcec9\",\"support_state\":\"guarded\"},{\"evidence_ids\":[],\"qualification\":\"The packet supplies dated records but no explicit comparison result or comparison counterpart for the target subject.\",\"requirement_id\":\"requirement:3dc718a9edd39cc43871502489f05ef8dd1fdcc5c597bcce7b1f01c635bef9f8\",\"support_state\":\"not_established\"},{\"evidence_ids\":[\"srcrec:a55c4f584d0df7b56e6bbb0836535a932715ccc7d22cf1b92efadab56aa87298\",\"srcrec:d8fb209670cfca62611a7804c58e10d05c8f2e1e39d5d5b369c61620a39c5f32\"],\"qualification\":\"The records permit inspection of named responsible persons and governance officials, but do not resolve lookup of the target subject's specific role.\",\"requirement_id\":\"requirement:2180d3f724251bd6c6e2d47121dc7ca33acf568b298ef4cc83a1bed42e8aa4ab\",\"support_state\":\"guarded\"},{\"evidence_ids\":[],\"qualification\":\"The supplied evidence does not establish operational responsibility from office holding.\",\"requirement_id\":\"requirement:2568996f80ff9a7e9c4a75a25969cb649ff29802c8130187ab07a60c023c67e3\",\"support_state\":\"guarded\"},{\"evidence_ids\":[\"srcrec:d8fb209670cfca62611a7804c58e10d05c8f2e1e39d5d5b369c61620a39c5f32\"],\"qualification\":\"The annual report is dated 30 June 2025 and gives governance appointment and resignation information for named officials.\",\"requirement_id\":\"requirement:41c8e36aa8ddeaf1017640b63c5dc86a93efefd1fabb703b4239d3063c59c119\",\"support_state\":\"supported\"},{\"evidence_ids\":[],\"qualification\":\"The evidence supports inspection of governance records, but does not establish that a particular governance role is used for access decisions.\",\"requirement_id\":\"