          "text": "{\"conclusion\":{\"confidence\":\"high\",\"evidence\":[{\"additional_meanings\":[],\"evidence_id\":\"srcrec:9ed8f0c4967b77cc4f29c082a3650f51e1fc418c0a4117f61663aff2f2806732\",\"note\":\"Program-level record supplies service, beneficiary, country, location, and statement-year context.\",\"role\":\"supporting\"},{\"additional_meanings\":[],\"evidence_id\":\"srcrec:f26ba76205c0be45b5e381f7fc3a7df8a2b3ff20490b5d8dca29310a26f07e06\",\"note\":\"Register record corroborates the same program-scoped service, beneficiary, country, and location fields.\",\"role\":\"supporting\"},{\"additional_meanings\":[],\"evidence_id\":\"srcrec:e203e8360cd04c896961bfa38935bc0005d9e4b2d1e14211ffcf3ae6d66d77de\",\"note\":\"Annual report provides a separately dated 2025 activity period but does not establish the requested filtering or exclusion operation.\",\"role\":\"context\"}],\"outcome\":\"insufficient_evidence\",\"rationale\":\"The packet supports a service record with associated geography and population fields, but it does not establish a completed audit/filter operation, an exclusion rule or selected cohort with exclusions, or a proposition about missingness. The service-period evidence is bounded to the 2025 statement/program context rather than an enduring period.\"},\"demand_requirement_support\":[{\"evidence_ids\":[\"srcrec:9ed8f0c4967b77cc4f29c082a3650f51e1fc418c0a4117f61663aff2f2806732\",\"srcrec:f26ba76205c0be45b5e381f7fc3a7df8a2b3ff20490b5d8dca29310a26f07e06\"],\"qualification\":null,\"requirement_id\":\"requirement:fab0d5b47a937567c6ffbb298283c8424ccbf42c0a4bda2e4f422aa99f905f0c\",\"support_state\":\"supported\"},{\"evidence_ids\":[\"srcrec:9ed8f0c4967b77cc4f29c082a3650f51e1fc418c0a4117f61663aff2f2806732\",\"srcrec:f26ba76205c0be45b5e381f7fc3a7df8a2b3ff20490b5d8dca29310a26f07e06\"],\"qualification\":\"The records join the service/program record to its coverage fields.\",\"requirement_id\":\"requirement:40145e3de996be597c92aa104c180286c97f7be79e72f37eab3d15a0c6ab7562\",\"support_state\":\"supported\"},{\"evidence_ids\":[\"srcrec:9ed8f0c4967b77cc4f29c082a3650f51e1fc418c0a4117f61663aff2f2806732\",\"srcrec:f26ba76205c0be45b5e381f7fc3a7df8a2b3ff20490b5d8dca29310a26f07e06\"],\"qualification\":\"The Individuals at Risk program has country and location fields.\",\"requirement_id\":\"requirement:1ed6404cff792acaf6032989740d70b8157e87e09fafd67947f62453f4fc78b9\",\"support_state\":\"supported\"},{\"evidence_ids\":[\"srcrec:9ed8f0c4967b77cc4f29c082a3650f51e1fc418c0a4117f61663aff2f2806732\",\"srcrec:f26ba76205c0be45b5e381f7fc3a7df8a2b3ff20490b5d8dca29310a26f07e06\"],\"qualification\":\"The program records list associated beneficiary categories.\",\"requirement_id\":\"requirement:d681a1d88a4f348bbfc33754d1e14984c754527170011be3a119f36387531c8e\",\"support_state\":\"supported\"},{\"evidence_ids\":[],\"qualification\":\"No packet evidence establishes that an audit was performed for this task.\",\"requirement_id\":\"requirement:d7e22c52a293ae6fd10e451f9a1b3d5225cd6fe7ef50fbc8ed7b572d9655a7a7\",\"support_state\":\"not_established\"},{\"evidence_ids\":[],\"qualification\":\"No packet evidence establishes a completed filter operation or its rule.\",\"requirement_id\":\"requirement:2781d3045ae1cf50eb1bcb97712e1bd0ce0f553adb635d583f997d7b49b39a46\",\"support_state\":\"not_established\"},{\"evidence_ids\":[],\"qualification\":\"Acknowledged as a non-inference constraint; exclusion or missingness must not be treated as proof that a service is not real.\",\"requirement_id\":\"requirement:b7b93afb768a4715c2a2d6fba5cc21859b3979698f467e42eda37100bce5edae\",\"support_state\":\"guarded\"},{\"evidence_ids\":[\"srcrec:9ed8f0c4967b77cc4f29c082a3650f51e1fc418c0a4117f61663aff2f2806732\",\"srcrec:f26ba76205c0be45b5e381f7fc3a7df8a2b3ff20490b5d8dca29310a26f07e06\"],\"qualification\":\"The cited evidence is explicitly service/program scoped.\",\"requirement_id\":\"requirement:5577d2b2522d05afbd6947bfa1fb947392c5458f550789775f9b1d18472ba842\",\"support_state\