          "text": "{\"conclusion\":{\"confidence\":\"high\",\"evidence\":[{\"additional_meanings\":[],\"evidence_id\":\"srcrec:12ec018c0e42d72a2027dce1c25d2d3ce6cb4c1ec3e1e76300ad00d737dab800\",\"note\":\"Official website states that cancer information and support is available for all Victorians affected by cancer and describes Victoria-focused research and services.\",\"role\":\"supporting\"},{\"additional_meanings\":[],\"evidence_id\":\"srcrec:827449099295a742ebf41e5f65d6eaf475808269daf7ef608fc1ac0346afdf0a\",\"note\":\"The 2025 directors' report and financial statements describe continuing prevention, screening, support, and research programs and identify their 2025 service activity.\",\"role\":\"supporting\"},{\"additional_meanings\":[],\"evidence_id\":\"srcrec:7455a5b3c5821ff15a17f8dc6cc5ef807054062fd397856d2c2608898a648ce5\",\"note\":\"Register data identifies Victoria as the operating state and records program beneficiaries as the general community in Australia, with program locations in East Melbourne.\",\"role\":\"supporting\"}],\"outcome\":\"supported\",\"rationale\":\"The packet provides service-specific descriptions, beneficiary information, delivery locations, Victoria operating geography, and a 2025 service period. The headquarters-versus-delivery-geography non-inference is acknowledged separately and is not used as evidence of equivalence.\"},\"demand_requirement_support\":[{\"evidence_ids\":[\"srcrec:7455a5b3c5821ff15a17f8dc6cc5ef807054062fd397856d2c2608898a648ce5\",\"srcrec:827449099295a742ebf41e5f65d6eaf475808269daf7ef608fc1ac0346afdf0a\",\"srcrec:12ec018c0e42d72a2027dce1c25d2d3ce6cb4c1ec3e1e76300ad00d737dab800\"],\"qualification\":\"The packet identifies the service subject through service descriptions, beneficiaries, and program records.\",\"requirement_id\":\"requirement:3af2097a570c1a60279d0caa51a92a9619c40cc33d594627b39376071eb04cf0\",\"support_state\":\"supported\"},{\"evidence_ids\":[\"srcrec:7455a5b3c5821ff15a17f8dc6cc5ef807054062fd397856d2c2608898a648ce5\",\"srcrec:12ec018c0e42d72a2027dce1c25d2d3ce6cb4c1ec3e1e76300ad00d737dab800\"],\"qualification\":\"Operating geography is Victoria, and the official service statement refers to all Victorians; program records locate delivery in East Melbourne.\",\"requirement_id\":\"requirement:c49da8007d94eab3d5d1a0848d767de5663dd8cb5e3aaa86440975f968db1c98\",\"support_state\":\"supported\"},{\"evidence_ids\":[\"srcrec:7455a5b3c5821ff15a17f8dc6cc5ef807054062fd397856d2c2608898a648ce5\",\"srcrec:12ec018c0e42d72a2027dce1c25d2d3ce6cb4c1ec3e1e76300ad00d737dab800\"],\"qualification\":\"Program beneficiaries are recorded as the general community in Australia, while the official website specifically describes support for Victorians affected by cancer.\",\"requirement_id\":\"requirement:d681a1d88a4f348bbfc33754d1e14984c754527170011be3a119f36387531c8e\",\"support_state\":\"supported\"},{\"evidence_ids\":[\"srcrec:7455a5b3c5821ff15a17f8dc6cc5ef807054062fd397856d2c2608898a648ce5\",\"srcrec:12ec018c0e42d72a2027dce1c25d2d3ce6cb4c1ec3e1e76300ad00d737dab800\"],\"qualification\":\"The service records support filtering to service-related programs and Victoria-linked delivery geography.\",\"requirement_id\":\"requirement:2781d3045ae1cf50eb1bcb97712e1bd0ce0f553adb635d583f997d7b49b39a46\",\"support_state\":\"supported\"},{\"evidence_ids\":[\"srcrec:7455a5b3c5821ff15a17f8dc6cc5ef807054062fd397856d2c2608898a648ce5\",\"srcrec:827449099295a742ebf41e5f65d6eaf475808269daf7ef608fc1ac0346afdf0a\"],\"qualification\":\"The evidence supplies a separate program location and service geography; it does not establish that headquarters equals delivery geography.\",\"requirement_id\":\"requirement:2e96e59ea937a7e339db612bd032aad4f38db53d7de1e0d8eb4432fb662aa76e\",\"support_state\":\"guarded\"},{\"evidence_ids\":[\"srcrec:7455a5b3c5821ff15a17f8dc6cc5ef807054062fd397856d2c2608898a648ce5\",\"srcrec:827449099295a742ebf41e5f65d6eaf475808269daf7ef608fc1ac0346afdf0a\",\"srcrec:12ec018c0e42d72a2027dce1c25d2d3ce6cb4c1ec3e1e76300ad00d737dab800\"],\"qualification\":\"Cited records contain service descriptions, program locations, beneficiary categories, and Victoria-specific service text.\",\"requirement_id\":\"requirement:5577d2b2522d05afbd6947bfa1fb947392c5458f550789775f9b1d18472ba842\",\"support_state\":\"supported\"},{\"evidence_ids\":[\"srcrec:7455a5b3c5821ff15a17f8dc6cc5ef807054062fd397856d2c2608898a648ce5\",\"srcrec:827449099295a742ebf41e5f65d6eaf475808269daf7ef608fc1ac0346afdf0a\",\"srcrec:12ec018c0e42d72a2027dce1c25d2d3ce6cb4c1ec3e1e76300ad00d737dab800\"],\"qualification\":\"The evidence supports constructing a cohort from the subject's cancer support, prevention, screening, research, and related programs.\",\"requirement_id\":\"requirement:36b0f742218221474a9d17b73d9f1e89f73a32441b1004e87df7efb3cda2834d\",\"support_state\":\"supported\"},{\"evidence_ids\":[\"srcrec:827449099295a742ebf41e5f65d6eaf475808269daf7ef608fc1ac0346afdf0a\",\"srcrec:7455a5b3c5821ff15a17f8dc6cc5ef807054062fd397856d2c2608898a648ce5\"],\"qualification\":\"The annual report covers the year ended 31 December 2025, and the register's program and operating records are part of the captured 2025 material.\",\"requirement_id\":\"requirement:ddb433563175e18e77ceefa55266cb9f632966970eaf19d0809c313fbb59ef21\",\"support_state\":\"supported\"}],\"proposition_support\":[{\"evidence_ids\":[\"srcrec:7455a5b3c5821ff15a17f8dc6cc5ef807054062fd397856d2c2608898a648ce5\",\"srcrec:827449099295a742ebf41e5f65d6eaf475808269daf7ef608fc1ac0346afdf0a\"],\"proposition_id\":\"proposition:533cbfe95669c4380a5e671d25fd9ae9699eda36f6c29c3d3be349cb2f3b778e\",\"qualification\":\"The regulator and annual report evidence describes the organisation's cancer-related purposes and continuing activities.\",\"scope_basis\":\"eligibility_criteria\",\"scope_status\":\"subject\",\"support_state\":\"supported\",\"temporal_status\":\"satisfied\"},{\"evidence_ids\":[\"srcrec:7455a5b3c5821ff15a17f8dc6cc5ef807054062fd397856d2c2608898a648ce5\",\"srcrec:12ec018c0e42d72a2027dce1c25d2d3ce6cb4c1ec3e1e76300ad00d737dab800\"],\"proposition_id\":\"proposition:bf8e5ca0b2d5abd3393eb6d13e8bdfc8934628e0110dfb67071d2fb819928f0c\",\"qualification\":\"The register records Victoria as the operating state and program locations in East Melbourne; the official website describes services for Victorians.\",\"scope_basis\":\"operational_geography\",\"scope_status\":\"bounded_scope\",\"support_state\":\"supported\",\"temporal_status\":\"satisfied\"},{\"evidence_ids\":[\"srcrec:7455a5b3c5821ff15a17f8dc6cc5ef807054062fd397856d2c2608898a648ce5\",\"srcrec:827449099295a742ebf41e5f65d6eaf475808269daf7ef608fc1ac0346afdf0a\",\"srcrec:12ec018c0e42d72a2027dce1c25d2d3ce6cb4c1ec3e1e76300ad00d737dab800\"],\"proposition_id\":\"proposition:9df6b026a8c6c26e3c3acd2370a16e93fffdc0015ff5bd879218788025db0280\",\"qualification\":\"The sources expressly describe support, prevention, screening, research, and related cancer services, with program beneficiaries and locations.\",\"scope_basis\":\"direct_service_coverage\",\"scope_status\":\"bounded_scope\",\"support_state\":\"supported\",\"temporal_status\":\"satisfied\"}],\"rejected_evidence_ids\":[\"srcrec:6324bbf9bde152c14cae6a5c2036ed652791b8601391627a5c9549597db13a07\"],\"selected_evidence_ids\":[\"srcrec:7455a5b3c5821ff15a17f8dc6cc5ef807054062fd397856d2c2608898a648ce5\",\"srcrec:827449099295a742ebf41e5f65d6eaf475808269daf7ef608fc1ac0346afdf0a\",\"srcrec:12ec018c0e42d72a2027dce1c25d2d3ce6cb4c1ec3e1e76300ad00d737dab800\"]}"
